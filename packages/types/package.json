{
  "name": "@ca/shared-types",
  "version": "0.0.1",
  "type": "module",
  "description": "Shared TypeScript types for the Cinematographer Agent monorepo",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ca/eslint-config": "workspace:*",
    "eslint": "^10.9.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0"
  },
  "license": "MIT"
}
